rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these staff accounts can read or change shop data.
    // Add each staff email in lowercase, then publish the rules (see SETUP.md).
    function isStaff() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'freshabi577@gmail.com',
          'lordjasto59@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
